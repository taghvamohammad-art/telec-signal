# Database (install.sh fills this in automatically)
DATABASE_URL=postgresql://telec:CHANGE_ME@localhost:5432/telec_signal

# Coverage. Light mode for a 2-core / 2 GB server: 40 symbols, 4 timeframes.
UNIVERSE_SIZE=100
ANALYSIS_SIZE=40
TIMEFRAMES=15m,1h,4h,1d
ALWAYS_INCLUDE=BTCUSDT,ETHUSDT
REQUIRE_LBANK=1
BACKFILL_DAYS=120

# Endpoints (defaults are correct; change only if Binance moves them again)
BINANCE_REST=https://fapi.binance.com
BINANCE_WS=wss://fstream.binance.com/market

# Admin alerts: a bot from @BotFather and your own chat id. Leave empty to only log.
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=

LOG_LEVEL=INFO
