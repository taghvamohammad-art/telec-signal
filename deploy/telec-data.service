[Unit]
Description=telec-signal data engine
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=telec
Group=telec
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m app.data.runner
Restart=always
RestartSec=10
TimeoutStopSec=20
# Exit code 2 = Binance blocked this server's region; restarting will not help
RestartPreventExitStatus=2
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
