[Unit]
Description=telec-signal live paper test of the lab combinations
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=telec
Group=telec
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m app.portfolio.service
Restart=always
RestartSec=10
TimeoutStopSec=20
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
